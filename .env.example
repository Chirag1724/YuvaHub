# Environment Variables Configuration
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173,https://yuvahub.xyz
PORT=3000
HOST=localhost
PUBLIC_URL=http://localhost:5173
FASTAPI_URL=http://127.0.0.1:8000
VERCEL_URL=
FRONTEND_URL=http://localhost:5173
TEST_API_URL=http://localhost:3000
CI=false
ANALYZE=false
SKIP_ENV_VALIDATION=false
ENABLE_MOCK_AUTH=false

# Admin Settings
ADMIN_EMAIL=admin@yuvahub.xyz
ADMIN_EMAILS=admin@yuvahub.xyz
ADMIN_SECRET=

# Database & Cache Connections (Keep server secrets blank)
MONGODB_URI=
MONGODB_COMMAND_URI=
MONGODB_QUERY_URI=
MONGODB_DB_NAME=yuvahub
MONGODB_COMMAND_DB=yuvahub
MONGODB_QUERY_DB=yuvahub
DB_NAME=yuvahub
REDIS_URL=
REDIS_HOST=localhost
RABBITMQ_URL=
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=
AI_CACHE_MAX_SIZE=500
AI_CACHE_TTL_MS=3600000

# Authentication & Security Secrets
JWT_SECRET=
JWT_REFRESH_SECRET=
ADMIN_SECRET_KEY=
ENCRYPTION_SECRET=

# AI & External APIs Integration
GEMINI_API_KEY=
GITHUB_TOKEN=

# Firebase Configuration
FIREBASE_SERVICE_ACCOUNT_BASE64=
FIREBASE_SERVICE_ACCOUNT_KEY=
FIREBASE_PROJECT_ID=yuvahub
FCM_PROJECT_ID=yuvahub

# Storage & Media Services
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email Services
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM=YuvaHub Alerts <noreply@yuvahub.xyz>
SMTP_USER=
SMTP_PASS=

# Observability
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=yuvahub
SENTRY_PROJECT=yuvahub

# Scraper Sources Configuration
SCRAPER_URL_<NORMALIZED_SOURCE_NAME>=
SCRAPER_URL_DEVPOST=https://devpost.com/hackathons

# Frontend Public Variables
REACT_APP_API_URL=/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:3000
VITE_API_URL=/api/v1
VITE_PUBLIC_URL=http://localhost:5173
VITE_WS_URL=ws://localhost:3000
VITE_ADMIN_EMAILS=admin@yuvahub.xyz
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_SENTRY_DSN=
VITE_SENTRY_DSN_REACT=
